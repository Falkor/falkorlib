<%= ("=" * config[:width]) + "\n" %>
Welcome to <%= config[:hostname].chomp %>
<%= ("=" * config[:width]) + "\n" %>
    <%= ::Artii::Base.new().asciify( config[:title] ).split("\n").join("\n    ") %>
<% if config[:subtitle] %>
    <%= ::Artii::Base.new().asciify( config[:subtitle] ).split("\n").join("\n    ") %>
<% end %>
<%= ("=" * config[:width]) + "\n" %>
  Hostname: <%= config[:hostname].chomp %>
  OS:       <%= config[:os] %>
  IP:       <%= Facter.value('networking.ip') %> (@mac: <%= Facter.value('networking.mac') %>)
  Support:  <%= config[:support] %>

 === <%= config[:desc] %> ===
 <%= config[:nodemodel] %>
 RAM: <%= Facter.value('memory.system.total') %> -- Swap size: <%= Facter.value('memory.swap.total') %>

